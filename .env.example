# Optional: enables model-backed roleplay and rubric feedback on the server.
# Keep these values out of client-side code and never commit a real secret.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

# Supabase is documented in the schema/setup guide; the current UI runs in demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
